{
  "name": "mountain-project",
  "version": "1.0.0",
  "description": "A local web portal for exploring mountain huts, bivouacs, and peaks via interactive maps, featuring an AI assistant for aggregating and summarizing hiking data",
  "license": "ISC",
  "author": "DaniMeri",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"tsx watch server.ts\" \"vite\"",
    "migrate:ai": "tsx scripts/migrate-ai-cache.ts",
    "fetch:data": "tsx scripts/fetch-pois.ts",
    "fetch:trails": "tsx scripts/fetch-trails.ts",
    "patch:tracks": "tsx scripts/patch-tracks-area.ts",
    "fetch:ferrata": "tsx scripts/fetch-via-ferrata.ts",
    "export:ferrata": "tsx scripts/export-via-ferrata.ts",
    "import:ferrata": "tsx scripts/import-via-ferrata.ts",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js",
    "build:frontend": "vite build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@google/generative-ai": "^0.24.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.4",
    "mapbox-gl": "^3.23.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  }
}
