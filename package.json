{
  "name": "mountain-project",
  "version": "1.0.0",
  "description": "A local web portal for exploring mountain huts, bivouacs, and peaks via interactive maps, featuring an AI assistant for aggregating and summarizing hiking data",
  "license": "ISC",
  "author": "DaniMeri",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "migrate:ai": "tsx scripts/migrate-ai-cache.ts",
    "fetch:data": "tsx scripts/fetch-pois.ts",
    "fetch:ferrata": "tsx scripts/fetch-via-ferrata.ts",
    "export:ferrata": "tsx scripts/export-via-ferrata.ts",
    "import:ferrata": "tsx scripts/import-via-ferrata.ts",
    "build": "esbuild server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@google/generative-ai": "^0.24.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.4",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
