# ─── AI Agent ─────────────────────────────────────────────────────────────────
# The models are tried in cascade order; each needs the key of its provider. Any one provider is
# enough to run the agent — the cascade simply skips models whose key is missing.

# Google AI Studio — first two models in the cascade. Free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — models 3 and 4. Free at https://console.groq.com → API Keys → Create
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — last model in the cascade. Free at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# YouTube Data API v3 — Google Cloud Console → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit script app — https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Facebook via Apify — optional, enables Facebook page post search
# Sign up free at https://apify.com → Settings → Integrations → API tokens
APIFY_TOKEN=your_apify_token_here

# Google Places API (New) — verified Google Maps links for huts/bivouacs.
# Cloud Console → enable "Places API (New)" → create a key → restrict it to that API alone.
# A billing account is required even though usage stays inside the free allowance; the console
# offers no adjustable cap for this API, so the ceiling is enforced in code (150/day, 4,500/month).
# Optional: without it the Google Maps section is omitted from descriptions.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── Mapbox ────────────────────────────────────────────────────────────────────
# Public token — get from mapbox.com → Account → Access Tokens
MAPBOX_TOKEN=your_mapbox_public_token_here

# ─── Database (local PostgreSQL + PostGIS — override if your setup differs) ─────
DB_USER=mountain_worker
DB_PASSWORD=mountain_secret_123
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mountain_db
