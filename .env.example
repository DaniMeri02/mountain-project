# ─── AI Agent ─────────────────────────────────────────────────────────────────
# Groq (primary) — free at https://console.groq.com → API Keys → Create
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (fallback) — free at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google AI Studio (legacy — no longer used)
# GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 — Google Cloud Console → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit script app — https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Facebook via Apify — optional, enables Facebook page post search
# Sign up free at https://apify.com → Settings → Integrations → API tokens
APIFY_TOKEN=your_apify_token_here

# Google Places API (enable when billing is ready)
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── Mapbox ────────────────────────────────────────────────────────────────────
# Public token — get from mapbox.com → Account → Access Tokens
MAPBOX_TOKEN=your_mapbox_public_token_here

# ─── Database (defaults match docker-compose — override if your setup differs) ──
DB_USER=mountain_worker
DB_PASSWORD=mountain_secret_123
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mountain_db
